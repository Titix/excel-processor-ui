{
  "name": "excel-processor-ui",
  "version": "1.0.0",
  "description": "Excel Processor with React frontend and Node.js backend",
  "main": "src/backend/server.js",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "jest --config test/jest.config.js --rootDir .",
    "test:watch": "jest --config test/jest.config.js --rootDir . --watch",
    "test:coverage": "jest --config test/jest.config.js --rootDir . --coverage",
    "test:unit": "jest --config test/jest.config.js --rootDir . --testPathPattern=\"(utils|App).test\"",
    "test:integration": "jest --config test/jest.config.js --rootDir . --testPathPattern=\"integration.test\"",
    "test:server": "jest --config test/jest.config.js --rootDir . --testPathPattern=\"server.test\"",
    "test:ci": "jest --config test/jest.config.js --rootDir . --ci --coverage --watchAll=false",
    "test:clean": "node test/runner.js test:clean",
    "eject": "react-scripts eject",
    "preview": "npm run build && serve -s build -l 3001",
    "preview-only": "serve -s build -l 3001",
    "server": "node src/backend/server.js",
    "dev": "nodemon src/backend/server.js",
    "build-server": "node src/backend/build.js",
    "install-all": "npm install"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.11.56",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.7.4",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/supertest": "^2.0.16",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.0.1",
    "serve": "^14.2.5",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1"
  },
  "keywords": [
    "excel",
    "processor",
    "react",
    "nodejs"
  ],
  "author": "Titix",
  "license": "MIT",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
