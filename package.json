{
  "name": "excel-processor-ui",
  "version": "1.0.0",
  "description": "Excel Processor with Angular frontend and Node.js backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "cd frontend && ng build --prod",
    "serve": "cd frontend && ng serve",
    "install-all": "npm install && cd frontend && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": ["excel", "processor", "angular", "nodejs"],
  "author": "Titix",
  "license": "MIT"
}