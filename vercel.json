{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npx ng build --configuration production",
  "outputDirectory": "frontend/dist/excel-processor-ui",
  "installCommand": "npm install",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
