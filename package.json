{
  "name": "excel-processor-ui",
  "version": "1.0.0",
  "description": "Excel Processor with React frontend and Node.js backend",
  "main": "src/backend/server.js",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "jest --config jest.config.js --rootDir .",
    "test:watch": "jest --config jest.config.js --rootDir . --watch",
    "test:coverage": "jest --config jest.config.js --rootDir . --coverage",
    "test:unit": "jest --config jest.config.js --rootDir . --testPathPattern=\"tests/unit\"",
    "test:unit:frontend": "jest --config jest.config.js --rootDir . --testPathPattern=\"tests/unit/frontend\"",
    "test:unit:backend": "jest --config jest.config.js --rootDir . --testPathPattern=\"tests/unit/backend\"",
    "test:integration": "jest --config jest.config.js --rootDir . --testPathPattern=\"tests/integration\"",
    "test:integration:frontend": "jest --config jest.config.js --rootDir . --testPathPattern=\"tests/integration/frontend\"",
    "test:integration:backend": "jest --config jest.config.js --rootDir . --testPathPattern=\"tests/integration/backend\"",
    "test:generate-excel": "node tests/integration/backend/generate-test-files.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "test:working": "jest --config jest.config.js --rootDir . --testPathPattern=\"(utils.test|LanguageSelector.simple.test|LanguageContext.simple.test|app-integration.simple.test|duplicate-detection.test)\"",
    "test:all-working": "npm run test:working && npm run test:e2e",
    "eject": "react-scripts eject",
    "preview": "npm run build && serve -s build -l 3001",
    "preview-only": "serve -s build -l 3001",
    "server": "node src/backend/server.js",
    "dev": "nodemon src/backend/server.js",
    "build-server": "node src/backend/build.js",
    "install-all": "npm install"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.11.56",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.7.4",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/supertest": "^2.0.16",
    "c8": "^10.1.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^27.5.1",
    "msw": "^2.11.6",
    "nodemon": "^3.0.1",
    "nyc": "^17.1.0",
    "serve": "^14.2.5",
    "supertest": "^6.3.3",
    "ts-jest": "^27.1.5",
    "ts-node": "^10.9.2"
  },
  "keywords": [
    "excel",
    "processor",
    "react",
    "nodejs"
  ],
  "author": "Titix",
  "license": "MIT",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
